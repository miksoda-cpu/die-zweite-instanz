# ===== Zustellung per E-Mail (Gmail-Beispiel) =====
# Gmail: App-Passwort unter https://myaccount.google.com/apppasswords
# erstellen (NICHT dein normales Passwort verwenden!)
INSTANZ_SMTP_HOST=smtp.gmail.com
INSTANZ_SMTP_PORT=587
INSTANZ_SMTP_USER=deine-adresse@gmail.com
INSTANZ_SMTP_PASS=xxxx-xxxx-xxxx-xxxx
INSTANZ_EMPFAENGER=deine-adresse@gmail.com

# ===== Optional: Notion =====
# Integration unter https://www.notion.so/my-integrations anlegen,
# Ziel-Seite mit der Integration teilen, Seiten-ID hier eintragen.
# Vorteil: Claude kann den Bericht dann im Chat direkt abrufen.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# ===== Optional: Claude als Tiefendenker =====
# Wenn gesetzt, übernimmt Claude die Tages-Synthese und die
# Handlungsempfehlungen; die Batch-Analysen bleiben immer lokal.
# TIEFENDENKER=claude
# ANTHROPIC_API_KEY=sk-ant-...
